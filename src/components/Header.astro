---
import { NAV } from '../config';
import Brand from './Brand.astro';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['site-header', { 'site-header--transparent': transparent }]} data-header>
  <div class="site-header__inner wrap">
    <div class="site-header__brand"><Brand size="4rem" /></div>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-nav__link', { 'is-current': isCurrent(item.href) }]}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="Switch between light and dark theme"
        title="Switch theme"
      >
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <button
        class="icon-btn nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <span class="nav-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .site-header.is-stuck {
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
    -webkit-backdrop-filter: saturate(1.6) blur(12px);
    border-bottom-color: var(--line);
    box-shadow: var(--shadow-sm);
  }

  /* Homepage: sit over the dark hero until the user scrolls. */
  .site-header--transparent:not(.is-stuck) {
    background: transparent;
    --ink: #fff;
    --ink-2: rgb(255 255 255 / 0.82);
    --line-strong: rgb(255 255 255 / 0.3);
    --accent: var(--brass-300);
    --accent-ink: #fff;
    --accent-soft: rgb(255 255 255 / 0.12);
    --on-accent: #08251a;
    color: #fff;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(100% - (var(--gutter) * 2), var(--wide));
    /* Guarantees clearance even if the brand block grows past the bar height. */
    padding-block: 0.5rem;
    min-width: 0;
  }

  /* ---- brand ----
     Markup and styling live in Brand.astro. Retheming happens through
     inherited custom properties, because a parent's class selectors can't
     reach inside a child component's scoped styles. */
  .site-header__brand {
    margin-right: auto;
    min-width: 0;
  }
  .site-header--transparent:not(.is-stuck) {
    --brand-sub: rgb(255 255 255 / 0.72);
  }

  /* ---- nav ---- */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    display: block;
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 550;
    color: var(--ink-2);
    text-decoration: none;
    position: relative;
    transition:
      color 0.15s var(--ease),
      background-color 0.15s var(--ease);
  }
  .site-nav__link:hover {
    color: var(--ink);
    background: var(--accent-soft);
  }
  .site-nav__link.is-current {
    color: var(--accent-ink);
  }
  .site-nav__link.is-current::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.18rem;
    translate: -50% 0;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--highlight);
  }

  /* ---- icon buttons ---- */
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .icon-btn {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    cursor: pointer;
    transition:
      background-color 0.15s var(--ease),
      color 0.15s var(--ease),
      border-color 0.15s var(--ease);
  }
  .icon-btn:hover {
    background: var(--accent-soft);
    color: var(--ink);
    border-color: var(--line);
  }
  .icon-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .icon-moon {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-sun {
    display: none;
  }
  :global(html[data-theme='dark']) .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .icon-sun {
      display: none;
    }
    :global(html:not([data-theme='light'])) .icon-moon {
      display: block;
    }
  }

  .nav-toggle {
    display: none;
  }
  .nav-toggle__bars {
    display: grid;
    gap: 4px;
    width: 1.15rem;
  }
  .nav-toggle__bars i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.25s var(--ease),
      opacity 0.2s var(--ease);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars i:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars i:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars i:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---- mobile ----
     Switches to the drawer at 1000px rather than 900px: with the larger nav
     text, six links plus the brand start crowding before that. */
  @media (max-width: 1000px) {
    .nav-toggle {
      display: grid;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
      padding: 1rem var(--gutter) 1.5rem;
      display: grid;
      gap: 0.75rem;
      transform-origin: top;
      transition:
        opacity 0.22s var(--ease),
        transform 0.22s var(--ease),
        visibility 0.22s;
    }

    :global(html.js) .site-nav {
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px) scaleY(0.98);
    }
    :global(html.js) .site-nav[data-open='true'] {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    /* Inside the drawer the header's transparent overrides shouldn't apply. */
    .site-header--transparent:not(.is-stuck) .site-nav {
      color: var(--ink);
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.1rem;
    }
    .site-nav__link {
      padding: 0.8rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 1.05rem;
      color: var(--ink);
    }
    .site-nav__link.is-current {
      background: var(--accent-soft);
      color: var(--accent-ink);
    }
    .site-nav__link.is-current::after {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .brand__text span {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      nav.dataset.open = String(open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close on escape, on outside click, and whenever we grow past the breakpoint.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const target = e.target as Node;
      if (!nav.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    window.matchMedia('(min-width: 1001px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Theme toggle. Respects the OS until someone makes a choice, then remembers it.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const current = root.getAttribute('data-theme') ?? (prefersDark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('crew167-theme', next);
    } catch {
      /* private browsing — the choice just won't stick */
    }
  });
</script>
