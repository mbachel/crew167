---
import TopoBg from './TopoBg.astro';

/** Dark banner at the top of every interior page. */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-header">
  <TopoBg />
  <div class="wrap page-header__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(90% 120% at 88% 0%, var(--band-glow-2), transparent 60%), var(--band-base);
    color: #fff;
    padding-block: clamp(2.75rem, 2rem + 4.5vw, 5rem);
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(2.25rem, 1.6rem + 3.5vw, 4rem));
  }

  .page-header::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--green-500), var(--brass-400), var(--green-500));
  }

  .page-header__inner {
    position: relative;
  }

  .page-header :global(.eyebrow) {
    color: var(--brass-300);
    margin-bottom: 0.9rem;
  }

  .page-header h1 {
    color: #fff;
    max-width: 18ch;
  }

  .page-header :global(.lede) {
    color: rgb(255 255 255 / 0.78);
    margin-top: 1.1rem;
  }
</style>
