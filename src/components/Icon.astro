---
/**
 * Small inline icon set (Lucide-style, hand-trimmed). Inline SVG rather than an
 * icon font or a runtime library — nothing to download, nothing to hydrate.
 */
const paths = {
  calendar:
    '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  pin: '<path d="M20 10.5c0 5.5-8 11-8 11s-8-5.5-8-11a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10.3" r="2.9"/>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3.2 6.4 8.1 5.7a1.2 1.2 0 0 0 1.4 0l8.1-5.7"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.8 8.2-2 5.6-5.6 2 2-5.6Z"/>',
  flag: '<path d="M5 21V4M5 4h9.5l-1.2 3.2L14.5 11H5"/>',
  bee: '<ellipse cx="12" cy="14" rx="4.2" ry="5.5"/><path d="M7.9 12.4h8.2M8 16h8"/><path d="M11 8.5 9.4 5.8M13 8.5l1.6-2.7"/><path d="M7.8 10.6C5.4 8.9 3 9.4 3.4 11.6c.3 1.7 2.6 2.4 4.4 1.6M16.2 10.6c2.4-1.7 4.8-1.2 4.4 1-.3 1.7-2.6 2.4-4.4 1.6"/>',
  tent: '<path d="m12 3.5 9 16.5H3Z"/><path d="M12 3.5V20M7.5 20l4.5-8 4.5 8"/>',
  users:
    '<circle cx="9" cy="8" r="3.6"/><path d="M2.8 20a6.3 6.3 0 0 1 12.4 0"/><path d="M16.4 4.8a3.6 3.6 0 0 1 0 6.7M18 20a6.3 6.3 0 0 0-2.2-4.8"/>',
  heart:
    '<path d="M12 20.3s-7.6-4.6-7.6-9.7A4.3 4.3 0 0 1 12 8.1a4.3 4.3 0 0 1 7.6 2.5c0 5.1-7.6 9.7-7.6 9.7Z"/>',
  // Personal Growth — a seedling: two leaves on a stem, rooted on the ground.
  sprout:
    '<path d="M12 20.5v-8.9"/><path d="M7.4 20.5h9.2"/><path d="M12 12.8C8.8 12.8 6.7 10.7 6.7 7.4c3.2 0 5.3 2.1 5.3 5.4z"/><path d="M12 10.7c0-3 2-5 5.1-5 0 3-2 5-5.1 5z"/>',
  'arrow-right': '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>',
  external: '<path d="M14 4.5h5.5V10M19 5l-8.4 8.4"/><path d="M18 14.5v4a2 2 0 0 1-2 2H5.5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>',
  'chevron-down': '<path d="m6 9.5 6 6 6-6"/>',
  search: '<circle cx="11" cy="11" r="6.6"/><path d="m20.5 20.5-4.8-4.8"/>',
  image:
    '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><circle cx="8.8" cy="10" r="1.8"/><path d="m3.6 17.8 4.9-4.4a2 2 0 0 1 2.7 0l5 4.6M15 14.4l1.7-1.5a2 2 0 0 1 2.7 0l1.2 1.1"/>',
  check: '<path d="m4.5 12.6 5 5 10-11"/>',
  shield: '<path d="M12 21.3s7.5-3.4 7.5-9.3V5.6L12 2.7 4.5 5.6v6.4c0 5.9 7.5 9.3 7.5 9.3Z"/>',
  download: '<path d="M12 3.5v12M7.2 11l4.8 4.8L16.8 11"/><path d="M4 20.5h16"/>',
};

interface Props {
  name: keyof typeof paths;
  class?: string;
  size?: number | string;
}

const { name, class: className, size } = Astro.props;

const dimension = typeof size === 'number' ? `${size}px` : size;
const style = dimension ? `width:${dimension};height:${dimension}` : undefined;
---

<svg
  class={className}
  style={style}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
