---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Lightbox from '../../components/Lightbox.astro';
import Icon from '../../components/Icon.astro';
import { getAlbums, formatAlbumDate, type Album } from '../../lib/gallery';

export const getStaticPaths = (async () => {
  const albums = await getAlbums();
  return albums.map((album, index) => ({
    params: { album: album.slug },
    props: {
      album,
      prev: albums[index - 1],
      next: albums[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  album: Album;
  prev?: Album;
  next?: Album;
}

const { album, prev, next } = Astro.props;

// The href each thumbnail points at: a big, optimised version for the viewer,
// and a plain link target when JavaScript is off.
const fullSize = await Promise.all(
  album.photos.map((photo) =>
    getImage({ src: photo.src, width: Math.min(photo.src.width, 1800), format: 'webp' }),
  ),
);

const dateLabel = formatAlbumDate(album.date);
---

<BaseLayout
  title={album.title}
  description={album.description ?? `${album.count} photos from ${album.title} — Venturing Crew 167.`}
>
  <PageHeader
    eyebrow={dateLabel ? `Gallery · ${dateLabel}` : 'Gallery'}
    title={album.title}
    lede={album.description}
  >
    <p class="album-meta">
      <a href="/gallery/">
        <Icon name="arrow-right" class="album-meta__back" />
        All albums
      </a>
      <span aria-hidden="true">·</span>
      <span>{album.count} photo{album.count === 1 ? '' : 's'}</span>
    </p>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      <ul class="photos">
        {
          album.photos.map((photo, i) => {
            const portrait = photo.src.height > photo.src.width * 1.15;
            return (
              <li class:list={['photos__item', { 'photos__item--tall': portrait }]}>
                <a
                  href={fullSize[i]!.src}
                  data-lightbox
                  data-caption={photo.caption ?? ''}
                  data-alt={photo.alt}
                  aria-label={`View photo ${i + 1} of ${album.count}`}
                >
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    widths={[300, 500, 760]}
                    sizes="(max-width: 560px) 46vw, (max-width: 1000px) 30vw, 23vw"
                    loading={i < 6 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  {photo.caption && <span class="photos__caption">{photo.caption}</span>}
                </a>
              </li>
            );
          })
        }
      </ul>

      {
        (prev || next) && (
          <nav class="album-nav" aria-label="Other albums">
            {prev ? (
              <a class="album-nav__link" href={`/gallery/${prev.slug}/`}>
                <span class="small muted">Newer album</span>
                <strong>{prev.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="album-nav__link album-nav__link--end" href={`/gallery/${next.slug}/`}>
                <span class="small muted">Older album</span>
                <strong>{next.title}</strong>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .album-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: rgb(255 255 255 / 0.7);
    font-size: var(--step--1);
  }
  .album-meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brass-300);
    text-decoration: none;
    font-weight: 550;
  }
  .album-meta a:hover {
    text-decoration: underline;
  }
  .album-meta :global(.album-meta__back) {
    width: 1rem;
    height: 1rem;
    transform: rotate(180deg);
  }

  /* -------------------------------------------------------------- grid */
  .photos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.5rem, 0.35rem + 0.7vw, 0.9rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    grid-auto-rows: 190px;
    grid-auto-flow: dense;
  }
  @media (max-width: 560px) {
    .photos {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 140px;
    }
  }

  /* Portrait shots get a taller cell, which keeps the grid from cropping
     everything to the same letterbox. */
  .photos__item--tall {
    grid-row: span 2;
  }

  .photos__item a {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--line);
    cursor: zoom-in;
  }

  .photos__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.5s var(--ease),
      filter 0.3s var(--ease);
  }

  .photos__item a:hover :global(img),
  .photos__item a:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .photos__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2rem 0.7rem 0.6rem;
    font-size: 0.76rem;
    line-height: 1.35;
    color: #fff;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.78));
    opacity: 0;
    transition: opacity 0.25s var(--ease);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .photos__item a:hover .photos__caption,
  .photos__item a:focus-visible .photos__caption {
    opacity: 1;
  }

  /* ---------------------------------------------------------- album nav */
  .album-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .album-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--ink);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s var(--ease);
  }
  .album-nav__link:hover {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .album-nav__link strong {
    font-family: var(--font-display);
    font-weight: 620;
  }
  .album-nav__link--end {
    text-align: right;
    margin-left: auto;
  }
</style>
