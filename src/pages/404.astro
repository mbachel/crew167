---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TopoBg from '../components/TopoBg.astro';
import { NAV } from '../config';
---

<BaseLayout title="Page not found" description="That page doesn't exist on the Crew 167 site.">
  <section class="notfound">
    <TopoBg />
    <div class="wrap notfound__inner">
      <p class="eyebrow">Error 404</p>
      <h1>Off the trail</h1>
      <p class="lede">
        That page isn't here. It may have moved when the site was rebuilt, or the link might have a
        typo in it.
      </p>

      <ul class="notfound__links">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
                <Icon name="arrow-right" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(70% 90% at 78% 8%, var(--band-glow-1), transparent 62%),
      linear-gradient(170deg, var(--band-base), var(--band-deep));
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + clamp(3rem, 2rem + 5vw, 6rem));
    padding-bottom: clamp(3rem, 2rem + 5vw, 6rem);
    min-height: 72svh;
    display: flex;
    align-items: center;
  }

  .notfound__inner {
    position: relative;
  }

  .notfound .eyebrow {
    color: var(--brass-300);
    margin-bottom: 1rem;
  }

  .notfound h1 {
    color: #fff;
  }

  .notfound :global(.lede) {
    color: rgb(255 255 255 / 0.78);
    margin-top: 1.1rem;
  }

  .notfound__links {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    max-width: 700px;
  }

  .notfound__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.05);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 550;
    transition:
      background-color 0.15s var(--ease),
      border-color 0.15s var(--ease);
  }
  .notfound__links a:hover {
    background: rgb(255 255 255 / 0.12);
    border-color: var(--brass-300);
    color: var(--brass-300);
  }
  .notfound__links :global(svg) {
    width: 1rem;
    height: 1rem;
    opacity: 0.6;
  }
</style>
