---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { MEETINGS, INTEGRATIONS, isCalendarConfigured, CONTACT } from '../config';
import { upcomingMeetings, formatMeetingDate, isoDate } from '../lib/meetings';
import { pageCopy } from '../lib/sections';

const Intro = (await pageCopy('calendar'))('intro');

const calendarId = INTEGRATIONS.googleCalendarId;
const tz = INTEGRATIONS.googleCalendarTimeZone;

const embedBase = `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(
  calendarId,
)}&ctz=${encodeURIComponent(tz)}&showTitle=0&showPrint=0&showTabs=1&showCalendars=0&showTz=0`;

const subscribeUrl = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(
  calendarId,
)}`;
const icsUrl = `https://calendar.google.com/calendar/ical/${encodeURIComponent(
  calendarId,
)}/public/basic.ics`;

const meetings = upcomingMeetings(4);
---

<BaseLayout
  title="Calendar"
  description="Meeting dates and upcoming events for Venturing Crew 167 — 1st and 3rd Tuesdays at Good Shepherd Church, Charlotte NC."
>
  <PageHeader
    eyebrow="Dates and events"
    title="Calendar"
    lede={`Come by any of our meetings - see our schedule below.`}
  />

  <section class="section">
    <div class="wrap cal">
      {/* ------------------------------------------------------- next up */}
      <aside class="cal__side" data-reveal>
        <div class="card cal__next">
          <h2 class="cal__next-title">
            <Icon name="clock" />
            Next meetings
          </h2>
          <ol class="cal__list" data-meeting-list>
            {
              meetings.map((meeting, i) => (
                <li class:list={['cal__item', { 'is-next': i === 0 }]}>
                  <time datetime={isoDate(meeting.date)}>{formatMeetingDate(meeting.date)}</time>
                  <span class="small muted" data-meeting-time>{MEETINGS.time}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="card cal__where">
          <h2 class="cal__next-title">
            <Icon name="pin" />
            Where
          </h2>
          <p>
            <strong>{MEETINGS.venue}</strong><br />
            <span class="muted">{MEETINGS.address}</span>
          </p>
          <a class="btn btn--ghost btn--sm" href={MEETINGS.mapUrl} rel="noopener">
            Open in Maps
            <Icon name="external" />
          </a>
        </div>

        {
          isCalendarConfigured && (
            <div class="card cal__subscribe">
              <h2 class="cal__next-title">
                <Icon name="calendar" />
                Subscribe
              </h2>
              <p class="small muted">
                Put the Crew calendar on your own phone so it updates automatically.
              </p>
              <div class="btn-row">
                <a class="btn btn--sm" href={subscribeUrl} rel="noopener">
                  Add to Google Calendar
                </a>
                <a class="btn btn--ghost btn--sm" href={icsUrl} rel="noopener">
                  Apple / Outlook (.ics)
                </a>
              </div>
            </div>
          )
        }
      </aside>

      {/* ------------------------------------------------------- calendar */}
      <div class="cal__main">
        <div class="prose cal__intro" data-reveal>
          <Intro />
        </div>

        {
          isCalendarConfigured ? (
            <div class="cal__frame" data-calendar data-src={embedBase} data-reveal>
              <div class="cal__placeholder">
                <Icon name="calendar" />
                <p class="small muted">Loading the crew calendar…</p>
                <noscript>
                  <a class="btn btn--sm" href={subscribeUrl} rel="noopener">
                    Open the calendar on Google
                  </a>
                </noscript>
              </div>
            </div>
          ) : (
            <div class="cal__setup" data-reveal>
              <Icon name="calendar" />
              <div>
                <h2>The calendar isn't connected yet</h2>
                <p>
                  Add the crew's Google Calendar ID to <code>src/config.ts</code> and this page will
                  render the live calendar. The step-by-step is in <code>SETUP.md</code>.
                </p>
                <p class="small muted">
                  Until then, meeting dates are listed on this page and you can always email{' '}
                  <a href={`mailto:${CONTACT.presidentEmail}`}>{CONTACT.presidentEmail}</a> to ask what's
                  coming up.
                </p>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cal {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
    align-items: start;
  }
  @media (max-width: 940px) {
    .cal {
      grid-template-columns: 1fr;
    }
  }

  .cal__side {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  @media (max-width: 940px) {
    .cal__side {
      position: static;
      order: 2;
    }
  }

  .cal__next-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }
  .cal__next-title :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }

  .cal__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .cal__item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--line-strong);
  }
  .cal__item time {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .cal__item.is-next {
    background: var(--accent-soft);
    border-left-color: var(--accent);
  }

  .cal__note {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .cal__where p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .cal__where :global(.btn svg),
  .cal__subscribe :global(.btn svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .cal__subscribe p {
    margin-bottom: 1rem;
  }

  .cal__intro {
    margin-bottom: 2rem;
  }

  /* ------------------------------------------------------------- embed */
  .cal__frame {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    aspect-ratio: 4 / 3;
    min-height: 480px;
  }
  @media (max-width: 700px) {
    .cal__frame {
      aspect-ratio: 3 / 4;
      min-height: 560px;
    }
  }

  .cal__frame :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .cal__placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    color: var(--ink-3);
  }
  .cal__placeholder :global(svg) {
    width: 2rem;
    height: 2rem;
  }

  /* ------------------------------------------------------------- setup */
  .cal__setup {
    display: flex;
    gap: 1.15rem;
    padding: clamp(1.35rem, 1rem + 1.4vw, 2rem);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .cal__setup > :global(svg) {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--accent);
  }
  .cal__setup h2 {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }
  .cal__setup p {
    color: var(--ink-2);
  }
  .cal__setup p + p {
    margin-top: 0.75rem;
  }
</style>

<script>
  import { upcomingMeetings, formatMeetingDate, isoDate } from '../lib/meetings';
  import { MEETINGS } from '../config';

  /* ------------------------------------------------------- meeting list */
  // Recomputed in the browser so the list stays correct between deploys.
  const list = document.querySelector<HTMLElement>('[data-meeting-list]');
  if (list) {
    // Update the server-rendered items in place rather than rebuilding them.
    // Elements made with createElement don't carry Astro's data-astro-cid-*
    // scope attribute, so a rebuilt list silently loses every .cal__item rule —
    // including the flex column that puts the date and time on separate lines.
    const items = Array.from(list.querySelectorAll<HTMLLIElement>('li'));
    const meetings = upcomingMeetings(items.length);

    items.forEach((li, i) => {
      const meeting = meetings[i];
      if (!meeting) {
        li.hidden = true;
        return;
      }
      li.hidden = false;
      li.classList.toggle('is-next', i === 0);

      const time = li.querySelector('time');
      if (time) {
        time.dateTime = isoDate(meeting.date);
        time.textContent = formatMeetingDate(meeting.date);
      }

      const detail = li.querySelector<HTMLElement>('[data-meeting-time]');
      if (detail) detail.textContent = MEETINGS.time;
    });
  }

  /* ----------------------------------------------------- calendar iframe */
  // Google's embed is heavy, so it loads only once it's nearly on screen —
  // and in agenda mode on phones, where a month grid is unreadable anyway.
  const host = document.querySelector<HTMLElement>('[data-calendar]');
  const base = host?.dataset.src;

  if (host && base) {
    const mount = () => {
      const compact = window.matchMedia('(max-width: 700px)').matches;
      const frame = document.createElement('iframe');
      frame.src = `${base}&mode=${compact ? 'AGENDA' : 'MONTH'}`;
      frame.title = 'Crew 167 calendar';
      frame.loading = 'lazy';
      frame.setAttribute('frameborder', '0');
      frame.setAttribute('scrolling', 'no');
      host.replaceChildren(frame);
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          mount();
        },
        { rootMargin: '400px 0px' },
      );
      io.observe(host);
    } else {
      mount();
    }
  }
</script>
